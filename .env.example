# URL publik situs (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://relawannusantara.org

# Analytics (diambil dari situs WordPress existing)
NEXT_PUBLIC_GA_ID=G-V2B0DLDRX6
NEXT_PUBLIC_META_PIXEL_ID=362997751405076

# Script ekspor (opsional)
WP_ORIGIN=https://relawannusantara.org
MEDIA_CONCURRENCY=3
EXPORT_CONCURRENCY=6

# Gambar lama hasil migrasi (folder wp-content/uploads) — lihat docs/MEDIA.md.
# Kosongkan saat development untuk memakai public/wp-content/uploads lokal.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.relawannusantara.org

# Gambar baru → Vercel Blob (otomatis ada di Vercel setelah Blob store dihubungkan;
# lokal: `vercel env pull .env.local`). Dipakai oleh `npm run media:upload`.
BLOB_READ_WRITE_TOKEN=
