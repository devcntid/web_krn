# URL publik situs (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://relawannusantara.org

# Analytics (diambil dari situs WordPress existing)
NEXT_PUBLIC_GA_ID=G-V2B0DLDRX6
NEXT_PUBLIC_META_PIXEL_ID=362997751405076

# Script ekspor (opsional)
WP_ORIGIN=https://relawannusantara.org
MEDIA_CONCURRENCY=3  # dipakai export & media:migrate
EXPORT_CONCURRENCY=6

# Semua media di Vercel Blob — lihat docs/MEDIA.md.
# Token: otomatis ada di Vercel setelah Blob store dihubungkan; lokal: `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
# Host Blob untuk media lama (dicetak oleh `npm run media:migrate`), mis.
# https://<store-id>.public.blob.vercel-storage.com — kosongkan saat development
# untuk memakai public/wp-content/uploads lokal.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Database Postgres (Neon via Vercel Marketplace) — lihat docs/DATABASE.md.
# Lokal: `vercel env pull .env.local` (pilih environment development/preview, BUKAN production).
DATABASE_URL=            # connection string pooled (dipakai aplikasi)
DATABASE_URL_UNPOOLED=   # koneksi langsung (dipakai drizzle-kit untuk migrasi)
