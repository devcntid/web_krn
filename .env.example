# URL publik situs (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://relawannusantara.org

# Analytics — sejak B14 dikelola di /admin/pengaturan; nilai ini hanya fallback bila
# baris settings.integrations belum ada. Skrip hanya dimuat di produksi (bukan dev/preview).
NEXT_PUBLIC_GA_ID=G-V2B0DLDRX6
NEXT_PUBLIC_META_PIXEL_ID=362997751405076

# Script ekspor (opsional)
WP_ORIGIN=https://relawannusantara.org
MEDIA_CONCURRENCY=3  # dipakai export & media:migrate
EXPORT_CONCURRENCY=6

# Semua media di Vercel Blob — lihat docs/MEDIA.md.
# Token: otomatis ada di Vercel setelah Blob store dihubungkan; lokal: `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
# Host Blob untuk media lama (dicetak oleh `npm run media:migrate`), mis.
# https://<store-id>.public.blob.vercel-storage.com — kosongkan saat development
# untuk memakai public/wp-content/uploads lokal.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Database Postgres (Neon via Vercel Marketplace) — lihat docs/DATABASE.md.
# Lokal: `vercel env pull .env.local` (pilih environment development/preview, BUKAN production).
DATABASE_URL=            # connection string pooled (dipakai aplikasi)
DATABASE_URL_UNPOOLED=   # koneksi langsung (dipakai drizzle-kit untuk migrasi)

# Admin CMS — Auth.js v5 (lihat docs/AUTH.md).
# Rahasia untuk mengenkripsi cookie sesi (JWT). Buat dengan: npx auth secret  atau  openssl rand -base64 33
AUTH_SECRET=
# (Opsional) kunci terpisah untuk mengenkripsi rahasia TOTP di database; default diturunkan dari AUTH_SECRET.
# Mengganti kunci ini/AUTH_SECRET membuat 2FA yang sudah terdaftar harus didaftarkan ulang.
TOTP_ENCRYPTION_KEY=
# Login Google (OAuth client "Web application"; redirect URI: https://<domain>/api/auth/callback/google).
# Kosongkan keduanya untuk menyembunyikan tombol Google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Hanya email Google terverifikasi dengan domain ini yang boleh masuk (tanpa "@"), mis. relawannusantara.org
ALLOWED_EMAIL_DOMAIN=
# Hanya untuk `npm run admin:create` non-interaktif (jangan disimpan permanen).
# ADMIN_PASSWORD=

# Redirect dinamis (/admin/seo) — Vercel Edge Config. EDGE_CONFIG dibaca src/proxy.ts;
# EDGE_CONFIG_ID + VERCEL_API_TOKEN dipakai src/server/redirects-sync.ts untuk menulis.
EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# Email undangan pengguna (/admin/pengguna) via Resend. Kosong = tautan undangan disalin manual.
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Cron (B16): /api/cron/publish/ menerbitkan post Terjadwal tiap 10 menit.
# Vercel mengirim header Authorization: Bearer <CRON_SECRET>. Isi dengan string acak panjang.
CRON_SECRET=

# GA4 Data API (B17) — kartu "Pengunjung 30 hari" di dashboard admin. Lihat src/server/ga4.ts.
# 1) Google Cloud: buat service account, aktifkan "Google Analytics Data API", unduh kunci JSON.
# 2) GA4 Admin → Akses properti: tambahkan email service account sebagai Viewer.
# GA4_PROPERTY_ID = ID properti numerik (bukan G-XXXX). GA4_PRIVATE_KEY = nilai "private_key" dari JSON.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
